generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum FormCategory {
  ROOM_TEMPERATURE
  FRIDGE_TEMPERATURE
}

model User {
  id           String           @id @default(uuid())
  username     String           @unique
  password     String
  fullName     String           @map("full_name")
  email        String?
  role         Role             @default(USER)
  isActive     Boolean          @default(true) @map("is_active")
  departmentId String?          @map("department_id")
  department   Department?      @relation(fields: [departmentId], references: [id])
  submissions  FormSubmission[]
  auditLogs    AuditLog[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@map("users")
}

model Department {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  category        String
  emailRecipients String[]         @map("email_recipients")
  emailCc         String[]         @map("email_cc")
  emailBcc        String[]         @map("email_bcc")
  isActive        Boolean          @default(true) @map("is_active")
  users           User[]
  submissions     FormSubmission[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("departments")
}

model FormTemplate {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  category    FormCategory
  fields      Json
  version     Int              @default(1)
  isActive    Boolean          @default(true) @map("is_active")
  submissions FormSubmission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("form_templates")
}

model FormSubmission {
  id            String              @id @default(uuid())
  templateId    String              @map("template_id")
  template      FormTemplate        @relation(fields: [templateId], references: [id])
  departmentId  String              @map("department_id")
  department    Department          @relation(fields: [departmentId], references: [id])
  submittedById String              @map("submitted_by_id")
  submittedBy   User                @relation(fields: [submittedById], references: [id])
  recordDate    DateTime            @map("record_date")
  data          Json
  remarks       String?
  status        String              @default("submitted")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  records       TemperatureRecord[]

  @@map("form_submissions")
}

model TemperatureRecord {
  id           String         @id @default(uuid())
  submissionId String         @map("submission_id")
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  location     String
  recordDate   DateTime       @map("record_date")
  timeSlot     String         @map("time_slot")
  temperature  Float?
  humidity     Float?
  isAbnormal   Boolean        @default(false) @map("is_abnormal")
  remarks      String?
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([submissionId, recordDate])
  @@index([recordDate, location])
  @@map("temperature_records")
}

model SmtpConfig {
  id        String   @id @default(uuid())
  host      String
  port      Int
  username  String
  password  String
  fromEmail String   @map("from_email")
  useTls    Boolean  @default(true) @map("use_tls")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("smtp_configs")
}

model CronjobConfig {
  id             String    @id @default(uuid())
  name           String    @unique
  cronExpression String    @map("cron_expression")
  description    String?
  isEnabled      Boolean   @default(true) @map("is_enabled")
  lastRunAt      DateTime? @map("last_run_at")
  nextRunAt      DateTime? @map("next_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("cronjob_configs")
}

model EmailLog {
  id           String   @id @default(uuid())
  departmentId String?  @map("department_id")
  recipients   String[]
  subject      String
  body         String
  status       String
  errorMessage String?  @map("error_message")
  sentAt       DateTime @default(now()) @map("sent_at")

  @@map("email_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}
